# ─────────────────────────────────────────────────────────────────────
#  Easiest path: don't edit this file. Run `garmin-mcp setup` instead —
#  it asks the two questions below and writes a .env for you, with the
#  password typed invisibly and the file locked to your user.
#
#  Otherwise: cp .env.example .env, fill in the two REQUIRED values, and
#  ignore everything under OPTIONAL unless you have a reason.
#
#  .env is gitignored. Never commit it.
# ─────────────────────────────────────────────────────────────────────


# ══ REQUIRED ═════════════════════════════════════════════════════════
# ...and only if you want to sync from Garmin automatically. Skip both
# and the project still works: drop FIT files exported from Garmin
# Connect into data/inbox/ and run `garmin-mcp import`.

GARMIN_EMAIL=
GARMIN_PASSWORD=


# ══ OPTIONAL — every value below is already the default ══════════════

# How to reach Garmin.
#   auto        try the light HTTP client, fall back to a browser if blocked
#   cffi        HTTP client only (fast, no Chromium)
#   playwright  real headless browser (heavy, survives stricter blocking)
GARMIN_BACKEND=auto

# Where data lives. Both are gitignored.
GARMIN_DATA_DIR=./data
GARMIN_DB_PATH=./data/garmin.duckdb
GARMIN_TOKEN_DIR=./data/.tokens

# Background sync: how often, and how many activities per cycle. The
# batch size keeps a first backfill from tripping Garmin's rate limits.
GARMIN_SYNC_INTERVAL_MINUTES=30
GARMIN_SYNC_BATCH_SIZE=25

# MCP transport. stdio is what a desktop client launches; switch to
# streamable-http only if something connects over the network — the
# server has no authentication of its own.
GARMIN_MCP_TRANSPORT=stdio
GARMIN_MCP_HOST=127.0.0.1
GARMIN_MCP_PORT=8000

# Logging. Always goes to stderr: under stdio, stdout carries the
# JSON-RPC frames and a stray line there breaks the connection.
GARMIN_LOG_LEVEL=INFO
GARMIN_LOG_FORMAT=json
