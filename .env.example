# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#   cp .env.example .env

# ─── Garmin Connect credentials ───────────────────────────────────────
# Only used by `garmin-mcp auth`, which is interactive and runs outside the
# MCP server. The server itself never authenticates.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=

# Which backend talks to Garmin:
#   cffi       — garminconnect + curl_cffi TLS impersonation (lightweight)
#   playwright — headless Chromium, real browser fingerprint (heavy, robust)
#   auto       — try cffi, fall back to playwright when auth fails
GARMIN_BACKEND=auto

# Where OAuth tokens are persisted. Keep it inside data/ so the gitignore
# rules already cover it.
GARMIN_TOKEN_DIR=./data/.tokens

# ─── Storage ──────────────────────────────────────────────────────────
GARMIN_DATA_DIR=./data
GARMIN_DB_PATH=./data/garmin.duckdb

# ─── Ingestion worker ─────────────────────────────────────────────────
# Minutes between automatic sync cycles.
GARMIN_SYNC_INTERVAL_MINUTES=30
# Max activities pulled per cycle — keeps the first backfill from hammering
# Garmin and tripping rate limits.
GARMIN_SYNC_BATCH_SIZE=25

# ─── MCP server ───────────────────────────────────────────────────────
# stdio | streamable-http
GARMIN_MCP_TRANSPORT=stdio
GARMIN_MCP_HOST=127.0.0.1
GARMIN_MCP_PORT=8000

# ─── Logging ──────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
GARMIN_LOG_LEVEL=INFO
# json | console  (json in production, console when debugging by hand)
GARMIN_LOG_FORMAT=json
